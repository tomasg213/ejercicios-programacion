---
interface Props {
  title: string;
  pubDate: Date;
  description: string;
  author: string;
  tags?: string[];
}

const { title, pubDate, description, author, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="blog-post">
  <header class="post-header">
    <span class="date">{formattedDate}</span>
    <h1>{title}</h1>
    <p class="description">{description}</p>
    <div class="meta">
      <span class="author">Por {author}</span>
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </header>
  
  <div class="post-content">
    <slot />
  </div>
</article>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }
  
  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #e5e7eb;
  }
  
  .date {
    color: var(--color-text-light);
    font-size: 0.875rem;
  }
  
  h1 {
    font-size: 2.5rem;
    margin: 0.5rem 0;
  }
  
  .description {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin: 1rem 0;
  }
  
  .meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
  
  .author {
    font-weight: 600;
  }
  
  .tag {
    background: var(--color-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
  }
  
  .post-content {
    font-size: 1.125rem;
    line-height: 1.8;
  }
  
  .post-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }
  
  .post-content :global(code) {
    background: #f3f4f6;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
  }
  
  .post-content :global(pre) {
    background: #1f2937;
    color: #f9fafb;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
</style>
