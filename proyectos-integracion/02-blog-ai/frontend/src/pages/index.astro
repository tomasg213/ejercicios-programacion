---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Welcome to Blog AI</h1>
    <p class="text-xl text-gray-600 mb-8">A modern blog with AI-powered content generation</p>
    <div class="flex gap-4">
      <a href="/posts" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">Browse Posts</a>
      <a href="/editor" class="bg-gray-200 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-300">Write a Post</a>
    </div>
  </main>
</Layout>
